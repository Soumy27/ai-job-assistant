{
  "manifest_version": 3,
  "name": "CareerAI — Job Application Assistant",
  "version": "1.1.0",
  "description": "Autofills job application forms from your CareerAI profile and drafts answers to the written questions.",
  "permissions": ["storage", "notifications", "alarms", "scripting", "activeTab", "tabs"],
  "host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_end"
    }
  ]
}
