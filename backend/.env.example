# Copy this file to ".env" and fill in real values. Never commit the real .env.

# Secret used to sign JWTs. Use a long random string. REQUIRED (server won't start without it).
JWT_SECRET=replace_with_a_long_random_string

# Port the API listens on (5005 avoids macOS AirPlay on 5000).
PORT=5005

# Neon PostgreSQL connection string. Data persists here.
# Get one free at https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini API key (FREE tier works). Get one at https://aistudio.google.com/apikey
# Optional: without it, the app falls back to template/regex responses.
GEMINI_API_KEY=your_gemini_api_key

# Google OAuth credentials for Gmail integration (from Google Cloud Console > Clients).
# Optional: only needed for the Gmail scanning feature.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5005/api/gmail/callback
