# ── Secrets — NEVER commit these ──
.env
.env.*
!.env.example
**/.env

# ── Dependencies ──
# No trailing slash: these must also match the node_modules *symlinks* that
# point at node_modules.nosync (see DEVELOPMENT.md — iCloud sync workaround).
node_modules
**/node_modules

# ── Build output ──
dist/
build/
**/dist/

# ── Logs ──
*.log
npm-debug.log*

# ── OS / editor cruft ──
.DS_Store
.vscode/
.idea/
*.swp

# iCloud: .nosync keeps deps out of Desktop sync (see DEVELOPMENT.md)
node_modules.nosync/
**/node_modules.nosync/

# ── Personal docs kept in the working folder, not for the public repo ──
/*.pdf

# Working files from the design skill (direction sheet, inspector output)
.taste-skill/
